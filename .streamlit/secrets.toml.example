# Copy this file to .streamlit/secrets.toml and put your real key in it.
# secrets.toml is listed in .gitignore, so it never reaches GitHub.
# On Streamlit Community Cloud, paste the same two lines into App settings > Secrets instead.
GEMINI_API_KEY = "paste-your-key-here"
GEMINI_MODEL = "gemini-3.1-flash-lite-preview, gemini-flash-latest, gemini-3.5-flash-lite"
